  "$changes": {
    "color.text.tertiary": {
      "from": "#9d9d9d",
      "to": "#6b6b72",
      "reason": "#9d9d9d is 2.71:1 on white and 2.46:1 on surface/1 (the input background), failing WCAG AA for text. #6b6b72 is 5.29:1 on white, 4.80:1 on surface/1 and 4.59:1 on surface/4, and shares text/secondary's cool undertone so the grey ramp stays consistent."
    },
    "color.primary.hover": {
      "from": "#5283ff",
      "to": "#1f52e0",
      "reason": "#5283ff is lighter than idle, so white button text drops to 3.47:1 on hover (fails AA). #1f52e0 darkens along idle's hue: white text is 6.28:1, and it is visibly distinct from idle (1.33:1 step) so the hover state reads clearly."
    }
  }
